  slides:
  - image: {fileID: 21300000, guid: a8d87505097964bee901055480e51e0c, type: 3}
    caption: "Mexa a cabe\xE7a para os lados e para cima e para baixo. \xC9 assim
      que voc\xEA joga! \n"
    imageSize: {x: 13.03, y: 6.87}
    imagePositionOffset: {x: 0, y: 1.05}
    imageScale: 0.68
  - image: {fileID: 21300000, guid: dfdfb9bd1b9754ad0b53d38b5ee02a79, type: 3}
    caption: "A sacola vai para onde sua cabe\xE7a for. Vire para a esquerda ou para
      a direita para pegar as coisas! "
    imageSize: {x: 7.5, y: 5.35}
    imagePositionOffset: {x: 0.18, y: 0.63}
    imageScale: 0.7
  - image: {fileID: 21300000, guid: 48ff14f83cbfd46a1adc040981996c0f, type: 3}
    caption: Pegue as roupas com a sacola e ganhe pontos!
    imageSize: {x: 4.54, y: 6.58}
    imagePositionOffset: {x: 0.04, y: 1.05}
    imageScale: 0.7
  - image: {fileID: 21300000, guid: b62d0ec1b304f4ba3a8ff2ad948dbf73, type: 3}
    caption: Ops! Deixou a roupa cair? Tudo bem, segue o jogo!
    imageSize: {x: 7.68, y: 5.72}
    imagePositionOffset: {x: 1.19, y: 0.56}
    imageScale: 0.7
  - image: {fileID: 21300000, guid: 840d843f66e8d414ca3e24bf78b05644, type: 3}
    caption: "Cuidado com a bomba! Se ela cair na sacola, voc\xEA perde um cora\xE7\xE3o. "
    imageSize: {x: 6.5, y: 6.64}
    imagePositionOffset: {x: 0.8, y: 1.11}
    imageScale: 0.7
  - image: {fileID: 21300000, guid: 5329376a6cfd64c1abbae6dc7bbfebbc, type: 3}
    caption: 'Pegue os cupons! Eles podem valer um desconto. '
    imageSize: {x: 7.17, y: 5.82}
    imagePositionOffset: {x: 1.06, y: 0.85}
    imageScale: 0.7
  - image: {fileID: 21300000, guid: 9787082df612f428a9bd3224132b53e4, type: 3}
    caption: "Voc\xEA tem 3 minutos. Pegue o m\xE1ximo de roupas que conseguir! "
    imageSize: {x: 9.23, y: 4.13}
    imagePositionOffset: {x: -0.39, y: 0.58}
    imageScale: 0.79
